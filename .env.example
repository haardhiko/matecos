# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=matecos
APP_ENV=development          # development | staging | production
APP_DEBUG=true
APP_SECRET_KEY=change-me-in-production-use-32-random-bytes
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
API_RELOAD=true
API_CORS_ORIGINS=["http://localhost:3000"]

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://matecos:secret@localhost:5432/matecos
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# ── LLM Providers (set at least one) ─────────────────────────────────────────
LLM_PROVIDER=openai          # openai | anthropic | gemini | ollama
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_MODEL=gpt-4o-mini

# ── Tool Registry ─────────────────────────────────────────────────────────────
TOOL_REGISTRY_PATH=./config/tools
MAX_TOOL_TIMEOUT_SECONDS=300
DEFAULT_TOOL_TIMEOUT_SECONDS=120

# ── Sandbox ───────────────────────────────────────────────────────────────────
SANDBOX_DOCKER_IMAGE=matecos-sandbox:latest
SANDBOX_NETWORK_MODE=none    # none | restricted
SANDBOX_MAX_MEMORY_MB=2048
SANDBOX_MAX_CPU_PERIOD=100000
SANDBOX_MAX_CPU_QUOTA=50000  # 50% of one CPU

# ── Security ──────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
API_KEY_HEADER=X-API-Key

# ── Observability ─────────────────────────────────────────────────────────────
OTEL_ENABLED=true
OTEL_SERVICE_NAME=matecos
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_TRACES_SAMPLER=always_on

# ── GitHub Adapter ────────────────────────────────────────────────────────────
GITHUB_TOKEN=
GITHUB_CLONE_BASE_DIR=/tmp/matecos/repos
GITHUB_MAX_REPO_SIZE_MB=500

# ── Risk Engine ───────────────────────────────────────────────────────────────
RISK_DEFAULT_POLICY=conservative  # conservative | balanced | permissive
RISK_AUTO_APPROVE_LOW=true
RISK_ESCALATION_WEBHOOK=

# ── Memory ────────────────────────────────────────────────────────────────────
WORKING_MEMORY_TTL_HOURS=24
EPISODIC_MEMORY_RETENTION_DAYS=90
EVENT_STORE_ARCHIVE_DAYS=365

# ── Budget Defaults ───────────────────────────────────────────────────────────
DEFAULT_MAX_COST_USD=10.0
DEFAULT_MAX_DURATION_SECONDS=3600
DEFAULT_MAX_AGENT_ITERATIONS=50
DEFAULT_MAX_TOOL_CALLS=200
DEFAULT_MAX_AGENT_DEPTH=5
DEFAULT_MAX_CONCURRENT_AGENTS=10
